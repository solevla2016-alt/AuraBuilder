# Фронтенд редактора: сборка Vite → раздача nginx.
#
# Собирается только внутри образа. Намеренно: исходники монтировать
# томом нельзя — внутри контейнера Linux, а путь репозитория на
# машине разработчика содержит кириллицу, и монтирование такого пути
# в контейнер ломает файловую систему и кеш Vite.

FROM node:20-alpine AS build

WORKDIR /src

# package-lock.json копируется раньше package.json только для порядка:
# слой с зависимостями переиспользуется, пока не меняются версии.
# packages/registry не копируется: это не npm-пакет, а папка со
# скриптами генерации, исходник для frontend-этапа сборки ниже.
COPY package.json package-lock.json ./
COPY packages/tokens/package.json packages/tokens/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @aurabuilder/web --include-workspace-root

# Плагин vite.config.ts читает docs/palette.json и генерирует токены
# виртуальным модулем, поэтому источник палитры нужен на этапе сборки.
COPY packages ./packages
COPY apps/web/ ./apps/web/
COPY docs/palette.json ./docs/palette.json

RUN npm run tokens:build \
    && npm run build --workspace @aurabuilder/web


FROM nginx:1.29-alpine

# nginx по умолчанию работает от root и пишет pid и кеш в системные
# каталоги. В контейнере достаточно собственных файлов, а права root
# не нужны: прокси и статика не требуют привилегий.
RUN apk add --no-cache curl

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/web/dist /usr/share/nginx/html

EXPOSE 80

# Проверка именно HTTP: процесс nginx может быть жив, а конфигурация —
# с ошибкой, и healthcheck должен это показывать.
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]