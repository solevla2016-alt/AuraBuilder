# Параметры Control Plane для локальной разработки.
# Скопируйте в .env и заполните под своё окружение.
#
# Файл .env НЕ коммитится (см. .gitignore). Этот пример — чтобы значения
# были известны заранее.

# --- Безопасность ---
# В продакшене DJANGO_SECRET_KEY обязателен: settings.py прерывает старт,
# если при DEBUG=0 ключ остался dev-значением по умолчанию.
DJANGO_SECRET_KEY=замените-на-длинный-случайный-ключ
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Редактор на 5173 обращается к API на 8000 — другой источник, нужен CORS.
DJANGO_CORS_ENABLED=1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- За обратным прокси (nginx, ingress) ---
# TLS терминируется на прокси. Без этого флага Django считает соединение
# незащищённым и редиректит каждый запрос на https по кругу.
# Включать только когда прямой доступ к Django закрыт прокси: заголовок
# X-Forwarded-Proto приходит от клиента и подделывается. В docker-compose
# значение уже задано.
DJANGO_TRUST_FORWARDED_PROTO=1

# Редирект на https. На локальном стенде сертификата нет, поэтому 0;
# в продакшене 1.
DJANGO_SECURE_SSL_REDIRECT=0

# Раздача статики через whitenoise: в контейнере отдельный сервис для
# файлов не нужен. По умолчанию включается при DEBUG=0.
WHITENOISE_ENABLED=1

# --- PostgreSQL ---
# Базу создаёт администратор, приложение только работает со схемой.
#
# Команда для администратора:
#   CREATE ROLE aurabuilder LOGIN PASSWORD 'пароль' CREATEDB;
#   CREATE DATABASE aurabuilder OWNER aurabuilder;
# CREATEDB нужен, чтобы manage.py test создавал временную тестовую базу.
POSTGRES_DB=aurabuilder
POSTGRES_USER=aurabuilder
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Без PostgreSQL на машине разработчика (тесты, быстрый запуск):
# USE_SQLITE=1

# --- Email: Яндекс 360 SMTP (ТЗ п.7.6) ---
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=no-reply@ваш-домен
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@ваш-домен

# Пока переменные пустые, письма печатаются в консоль (console backend).
