# Переменные окружения для docker compose.
#
# Скопируйте в .env: cp .env.example .env
# Файл .env не коммитится. Значения ниже — для локальной машины и
# для стенда внутри команды; в продакшене секреты приходят из
# менеджера секретов, а не из файла в репозитории.

# --- Django ---
# В продакшене ключ обязателен: settings.py прерывает старт, если при
# DJANGO_DEBUG=0 осталось dev-значение. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=замените-на-длинный-случайный-ключ
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Через запятую, без пробелов. Пусто, если фронт и API на одном домене.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=aurabuilder
POSTGRES_USER=aurabuilder
POSTGRES_PASSWORD=замените-на-пароль
# Порт на машине разработчика, чтобы не конфликтовать с локальным
# PostgreSQL 18. Внутри compose всегда 5432.
POSTGRES_PORT=5432

# --- Порты контейнеров ---
WEB_PORT=8080
API_PORT=8000

# --- Антиперебор паролей (ТЗ п.7.7) ---
# Боевое значение по ТЗ — 5 попыток за 10 минут. Здесь выше, потому что
# стенд используют автопроверки редактора: каждая делает вход, и на
# боевом лимите прогон падал бы с 429 посреди теста. На боевом контуре
# вернуть 5.
LOGIN_ATTEMPT_LIMIT=50
LOGIN_ATTEMPT_WINDOW_MINUTES=10

# --- Email: Яндекс 360 SMTP (ТЗ п.7.6) ---
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=no-reply@ваш-домен
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@ваш-домен

# Пока SMTP не настроен, письма печатаются в консоль. В контейнере
# console backend неудобен — локальный сервер писем удобнее.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend